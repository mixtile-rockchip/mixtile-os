diff --git a/arch/arm64/boot/dts/rockchip/overlay/mixtile-core3588e-camera-imx415-cam0.dts b/arch/arm64/boot/dts/rockchip/overlay/mixtile-core3588e-camera-imx415-cam0.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/overlay/mixtile-core3588e-camera-imx415-cam0.dts
@@ -0,0 +1,236 @@
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/clock/rk3588-cru.h>
+#include <dt-bindings/power/rk3588-power.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+
+/ {
+	metadata {
+		title = "Enable IMX415 camera on CAM0";
+		compatible = "mixtile,core3588e";
+		category = "camera";
+		exclusive = "csi2_dphy0";
+		description = "Enable a Sony IMX415 camera module on CAM0.";
+	};
+
+	fragment@0 {
+		target-path = "/";
+		__overlay__ {
+			camera0_pwdn_gpio: camera0-pwdn-gpio {
+				status = "okay";
+				compatible = "regulator-fixed";
+				regulator-name = "camera0_pwdn_gpio";
+				regulator-always-on;
+				regulator-boot-on;
+				enable-active-high;
+				gpio = <&gpio1 RK_PB0 GPIO_ACTIVE_HIGH>;
+			};
+
+			i2cmux1:i2cmux1 {
+				compatible = "i2c-mux-gpio";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				i2c-parent = <&i2c2>;
+				mux-gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_HIGH>;
+
+				i2c_cam0: i2c@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+				};
+			};
+		};
+	};
+
+	fragment@1 {
+		target = <&i2c2>;
+		__overlay__ {
+			status = "okay";
+			pinctrl-names = "default";
+			pinctrl-0 = <&i2c2m4_xfer>;
+		};
+	};
+
+	fragment@2 {
+		target = <&i2cmux1>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@3 {
+		target = <&rkcif>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@4 {
+		target = <&rkcif_mmu>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@5 {
+		target = <&rkisp0>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@6 {
+		target = <&isp0_mmu>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@7 {
+		target = <&i2c_cam0>;
+		__overlay__ {
+			camera0_imx415: camera0-imx415@37 {
+				status = "okay";
+				compatible = "sony,imx415";
+				reg = <0x37>;
+				clocks = <&cru CLK_MIPI_CAMARAOUT_M0>;
+				clock-names = "xvclk";
+				pinctrl-names = "default";
+				pinctrl-0 = <&mipim1_camera0_clk>;
+				power-domains = <&power RK3588_PD_VI>;
+				rockchip,camera-module-index = <0>;
+				rockchip,camera-module-facing = "back";
+				rockchip,camera-module-name = "rpi-camera-v2";
+				rockchip,camera-module-lens-name = "default";
+
+				port {
+					camera0_imx415_out: endpoint {
+						remote-endpoint = <&csi2_dphy0_in_cam0>;
+						data-lanes = <1 2 3 4>;
+					};
+				};
+			};
+		};
+	};
+
+	fragment@8 {
+		target = <&csi2_dphy0>;
+		__overlay__ {
+			status = "okay";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					csi2_dphy0_in_cam0: endpoint@1 {
+						reg = <1>;
+						remote-endpoint = <&camera0_imx415_out>;
+						data-lanes = <1 2 3 4>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					csi2_dphy0_out_cam0: endpoint@0 {
+						reg = <0>;
+						remote-endpoint = <&mipi2_csi2_in_cam0>;
+					};
+				};
+			};
+		};
+	};
+
+	fragment@9 {
+		target = <&csi2_dphy0_hw>;
+		__overlay__ {
+			status = "okay";
+		};
+	};
+
+	fragment@10 {
+		target = <&mipi2_csi2>;
+		__overlay__ {
+			status = "okay";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					mipi2_csi2_in_cam0: endpoint@1 {
+						reg = <1>;
+						remote-endpoint = <&csi2_dphy0_out_cam0>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					mipi2_csi2_out_cam0: endpoint@0 {
+						reg = <0>;
+						remote-endpoint = <&rkcif_mipi_lvds2_in_cam0>;
+					};
+				};
+			};
+		};
+	};
+
+	fragment@11 {
+		target = <&rkcif_mipi_lvds2>;
+		__overlay__ {
+			status = "okay";
+
+			port {
+				rkcif_mipi_lvds2_in_cam0: endpoint {
+					remote-endpoint = <&mipi2_csi2_out_cam0>;
+				};
+			};
+		};
+	};
+
+	fragment@12 {
+		target = <&rkcif_mipi_lvds2_sditf>;
+		__overlay__ {
+			status = "okay";
+
+			port {
+				rkcif_mipi_lvds2_sditf_out: endpoint {
+					remote-endpoint = <&isp0_vir0_in_cam0>;
+				};
+			};
+		};
+	};
+
+	fragment@13 {
+		target = <&rkisp0_vir0>;
+		__overlay__ {
+			status = "okay";
+
+			port {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				isp0_vir0_in_cam0: endpoint@0 {
+					reg = <0>;
+					remote-endpoint = <&rkcif_mipi_lvds2_sditf_out>;
+				};
+			};
+		};
+	};
+};
